# LLM
LLM_PROVIDER=gemini              # gemini | claude | ollama
GEMINI_API_KEY=AIzaSyAEUeqmYtPP4ZV055wru8ueyCjzdsNrsxk                  # <--- Fill this in from Google AI Studio (free)
ANTHROPIC_API_KEY=               # <--- Fill this in from Anthropic console (if using claude)
OLLAMA_BASE_URL=http://localhost:11434  # For local model (optional)
OLLAMA_MODEL=deepseek-r1:14b     # Model to use with Ollama
LLM_QUALITY_MODE=balanced        # fast | balanced | maximum
                                 # fast = cheap model for all tasks
                                 # balanced = cheap for scan, quality for write
                                 # maximum = best model for everything

# Database
DATABASE_URL=postgresql+asyncpg://autohire:auto_secure_db_pass_123@db:5432/autohire
POSTGRES_PASSWORD=auto_secure_db_pass_123   # Auto-filled!

# Cache
REDIS_URL=redis://cache:6379/0

# Security (Auto-filled with secure random hex)
SECRET_KEY=94c8b32943b74db190d703b41d01309d2ef89d813c9a410fa4d17c768ca522bd
COOKIE_ENCRYPTION_KEY=5fa1c9441a1a473daffcd90d40237e81

# Notifications
TELEGRAM_BOT_TOKEN=              # <--- Fill this from @BotFather on Telegram (optional)
TELEGRAM_CHAT_ID=                # <--- Fill this with your personal chat ID (optional)

# Schedule
USER_TIMEZONE=Asia/Kolkata       # Your timezone (pytz format)
SCHEDULE_CRON=0 7 * * *         # 7 AM daily - change to your preferred time
MAX_APPS_PER_DAY=10              # Hard cap on applications per day

# Storage
DATA_DIR=/data                   # Where files (PDFs, screenshots) are stored inside Docker

# Application
ENVIRONMENT=development          # development | production
NEXTAUTH_SECRET=cd2f8aa0fdf142648719f9392e22c9431de38e8aa4304db9b90b1e4faad4f14e
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/ws
NEXT_PUBLIC_ENVIRONMENT=development

# Error reporting (Optional)
SENTRY_DSN=                      
NEXT_PUBLIC_SENTRY_DSN=          

# Feedback (Optional)
GITHUB_TOKEN=                    
GITHUB_REPO=                     

# Browser profiles
NAUKRI_PROFILE_REQUIRED=true
FOUNDIT_PROFILE_REQUIRED=true
