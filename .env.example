# LLM
LLM_PROVIDER=gemini              # gemini | claude | ollama
GEMINI_API_KEY=                  # From Google AI Studio (free)
ANTHROPIC_API_KEY=               # From Anthropic console
OLLAMA_BASE_URL=http://localhost:11434  # For local model (optional)
OLLAMA_MODEL=deepseek-r1:14b     # Model to use with Ollama
LLM_QUALITY_MODE=balanced        # fast | balanced | maximum
                                 # fast = cheap model for all tasks
                                 # balanced = cheap for scan, quality for write
                                 # maximum = best model for everything

# Database
DATABASE_URL=postgresql+asyncpg://autohire:yourpassword@db:5432/autohire
POSTGRES_PASSWORD=yourpassword   # Change this before running

# Cache
REDIS_URL=redis://cache:6379/0

# Security
SECRET_KEY=                      # Generate: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=           # Generate: openssl rand -hex 16

# Notifications
TELEGRAM_BOT_TOKEN=              # From @BotFather on Telegram
TELEGRAM_CHAT_ID=                # Your personal chat ID

# Schedule
USER_TIMEZONE=Asia/Kolkata       # Your timezone (pytz format)
SCHEDULE_CRON=0 7 * * *         # 7 AM daily - change to your preferred time
MAX_APPS_PER_DAY=10              # Hard cap on applications per day

# Storage
DATA_DIR=/data                   # Where files (PDFs, screenshots) are stored inside Docker

# Application
ENVIRONMENT=development          # development | production
NEXTAUTH_SECRET=                 # Generate: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/ws
NEXT_PUBLIC_ENVIRONMENT=development

# Error reporting
SENTRY_DSN=                      # Only needed in production. Get free DSN from sentry.io
NEXT_PUBLIC_SENTRY_DSN=          # Only needed in production. Frontend DSN from sentry.io

# Feedback
GITHUB_TOKEN=                    # Optional: create GitHub issues from feedback
GITHUB_REPO=                     # Optional: owner/repo for feedback issues

# Browser profiles
NAUKRI_PROFILE_REQUIRED=true
FOUNDIT_PROFILE_REQUIRED=true
